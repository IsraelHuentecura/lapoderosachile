---
import Layout from '../layouts/Layout.astro'
import Barrio from '../components/Barrio.astro'

// Enlace a redes. Cambia el handle si el de Instagram es distinto.
const INSTAGRAM_URL = 'https://www.instagram.com/lapoderosachile'

// Cinta en movimiento (sin estrellas).
const palabras = [
  'COMUNIDAD',
  'EDUCACIÓN POPULAR',
  'BARRIO',
  'AUTOGESTIÓN',
  'ACCIÓN COLECTIVA',
  'TERRITORIO',
  'DIGNIDAD',
]

// Datos del movimiento.
const stats = [
  { n: '2004', t: 'desde las villas' },
  { n: '11', t: 'países de la región' },
  { n: '+100', t: 'barrios organizados' },
  { n: '20', t: 'asentamientos' },
]

// Ejes de trabajo.
const ejes = [
  {
    n: '01',
    titulo: 'Educación popular',
    texto:
      'Aprendemos y enseñamos entre todas y todos, desde la experiencia del barrio y la palabra compartida.',
  },
  {
    n: '02',
    titulo: 'Trabajo comunitario',
    texto:
      'Asambleas, comedores y proyectos autogestionados: la comunidad al servicio de la comunidad.',
  },
  {
    n: '03',
    titulo: 'Deporte y cultura',
    texto:
      'Espacios abiertos donde el deporte y la cultura se vuelven herramientas de encuentro y transformación.',
  },
  {
    n: '04',
    titulo: 'Comunicación popular',
    texto:
      'El motor que proyecta las voces de los barrios para disputar la agenda pública y contar lo que falta.',
  },
]
---

<Layout title="La Poderosa Chile">
  <!-- ░░ HERO ░░ -->
  <header class="hero" data-hero>
    <div class="hero__inner">
      <h1 class="hero__lema" data-hero-lema>La comunidad al servicio de la comunidad</h1>
      <p class="lead" data-hero-item>
        Somos parte de <strong>La Poderosa</strong>, un movimiento social
        latinoamericano que organiza los barrios desde la autogestión y la acción
        colectiva. En Chile sumamos nuestra voz a esa red continental.
      </p>
      <a
        class="btn"
        data-hero-item
        href={INSTAGRAM_URL}
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor">
          <path d="M12 2.2c3.2 0 3.6 0 4.9.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.05.41 2.23.06 1.27.07 1.65.07 4.86s0 3.6-.07 4.86c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.05.36-2.23.41-1.27.06-1.65.07-4.9.07s-3.6 0-4.86-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.05-.41-2.23C2.2 15.6 2.2 15.2 2.2 12s0-3.6.07-4.86c.05-1.18.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.05-.36 2.23-.41C8.46 2.2 8.84 2.2 12 2.2Zm0 1.95c-3.15 0-3.52 0-4.76.07-.9.04-1.39.2-1.71.32-.43.17-.74.37-1.06.69-.32.32-.52.63-.69 1.06-.13.32-.28.81-.32 1.71-.06 1.24-.07 1.61-.07 4.76s0 3.52.07 4.76c.04.9.2 1.39.32 1.71.17.43.37.74.69 1.06.32.32.63.52 1.06.69.32.13.81.28 1.71.32 1.24.06 1.61.07 4.76.07s3.52 0 4.76-.07c.9-.04 1.39-.2 1.71-.32.43-.17.74-.37 1.06-.69.32-.32.52-.63.69-1.06.13-.32.28-.81.32-1.71.06-1.24.07-1.61.07-4.76s0-3.52-.07-4.76c-.04-.9-.2-1.39-.32-1.71a2.85 2.85 0 0 0-.69-1.06 2.85 2.85 0 0 0-1.06-.69c-.32-.13-.81-.28-1.71-.32-1.24-.06-1.61-.07-4.76-.07Zm0 3.32a4.53 4.53 0 1 1 0 9.06 4.53 4.53 0 0 1 0-9.06Zm0 1.95a2.58 2.58 0 1 0 0 5.16 2.58 2.58 0 0 0 0-5.16Zm4.74-3.3a1.06 1.06 0 1 1 0 2.12 1.06 1.06 0 0 1 0-2.12Z"></path>
        </svg>
        Síguenos en Instagram
      </a>
    </div>
    <img
      class="hero__logo"
      data-hero-logo
      src="/logo.png"
      alt="La Poderosa Chile"
      width="1999"
      height="1414"
    />
    <div class="hero__franja" aria-hidden="true"></div>
  </header>

  <!-- ░░ MARQUEE ░░ -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track" data-marquee>
      {
        [...palabras, ...palabras].map((p) => (
          <span class="marquee__item">
            {p}
            <span class="marquee__sep">/</span>
          </span>
        ))
      }
    </div>
  </div>

  <main>
    <!-- ░░ QUIÉNES SOMOS ░░ -->
    <section class="somos" id="quienes-somos">
      <h2 class="seccion-title" data-reveal>Quiénes somos</h2>
      <div class="somos__texto" data-reveal>
        <p>
          La Poderosa es un movimiento social que nació en <strong>2004</strong>
          en las villas de Argentina y hoy es una comunidad latinoamericana
          presente en <strong>11 países</strong>. Somos
          <em>la comunidad al servicio de la comunidad</em>: una herramienta
          organizativa que promueve procesos participativos y democráticos en
          los barrios, desde la autogestión y la acción colectiva, con un solo
          objetivo: transformar nuestra realidad.
        </p>
        <p>
          En Chile tejemos esa misma red, desde la educación popular, el trabajo
          comunitario, el deporte y la cultura. Porque creemos que la
          comunicación es una herramienta clave para conseguir cambios reales:
          el motor que proyecta las voces de los barrios para disputar la
          agenda pública.
        </p>
      </div>
    </section>

    <!-- ░░ STATS ░░ -->
    <section class="stats" data-reveal>
      {
        stats.map((s) => (
          <div class="stat" data-stat>
            <span class="stat__n">{s.n}</span>
            <span class="stat__t">{s.t}</span>
          </div>
        ))
      }
    </section>

    <!-- ░░ QUÉ HACEMOS ░░ -->
    <section class="que" id="que-hacemos">
      <h2 class="seccion-title" data-reveal>Qué hacemos</h2>
      <div class="grid">
        {
          ejes.map((eje) => (
            <article class="card" data-card>
              <span class="card__n">{eje.n}</span>
              <h3>{eje.titulo}</h3>
              <p>{eje.texto}</p>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ░░ FRASE ░░ -->
    <section class="manifiesto">
      <p class="manifiesto__texto" data-reveal-words>
        Desde el barrio, con el barrio y para el barrio.
      </p>
    </section>

    <!-- ░░ BARRIO ░░ -->
    <div class="barrio-band" aria-hidden="false">
      <Barrio />
    </div>

    <!-- ░░ CTA ░░ -->
    <section class="cta" data-reveal>
      <h2>Súmate</h2>
      <p>
        Acércate, participa y conoce en qué estamos. Las novedades y
        convocatorias las publicamos en nuestro Instagram.
      </p>
      <a class="btn" href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">
        @lapoderosachile
      </a>
    </section>
  </main>

  <footer>
    <p class="footer__name">LA PODEROSA CHILE</p>
    <p class="muted">Comunidad al servicio de la comunidad · {new Date().getFullYear()}</p>
  </footer>
</Layout>

<style>
  /* ░░ HERO ░░ */
  .hero {
    position: relative;
    background: #d8d3c8 url('/ladrillo.svg') repeat;
    background-size: 220px auto;
    min-height: clamp(440px, 80vh, 660px);
    display: grid;
    place-items: center;
    padding: clamp(3.5rem, 9vw, 6.5rem) 1.5rem clamp(5.5rem, 11vw, 8rem);
    text-align: center;
    overflow: hidden;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    max-width: 900px;
  }
  /* logo discreto, como firma en la esquina inferior derecha */
  .hero__logo {
    position: absolute;
    right: clamp(0.75rem, 3vw, 2.75rem);
    bottom: clamp(1.25rem, 4vw, 2.75rem);
    width: clamp(108px, 16vw, 210px);
    height: auto;
    opacity: 0.9;
    mix-blend-mode: multiply;
    pointer-events: none;
    z-index: 0;
    will-change: transform, opacity;
  }
  /* protagonista del hero */
  .hero__lema {
    font-family: var(--marca);
    font-size: clamp(2.4rem, 7vw, 5rem);
    line-height: 1.08;
    letter-spacing: 0.01em;
    color: var(--negro);
    max-width: 15ch;
    margin: 0 auto;
  }
  /* máscara para la animación palabra-por-palabra */
  .hero__lema :global(.w-wrap) {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding: 0 0.06em 0.12em;
  }
  .hero__lema :global(.w) {
    display: inline-block;
    will-change: transform;
  }
  .hero__lema :global(.w--rojo) {
    color: var(--rojo);
  }
  .hero__lema::after {
    content: '';
    display: block;
    width: 70px;
    height: 5px;
    background: var(--rojo);
    margin: 1rem auto 0;
  }
  .lead {
    font-size: clamp(1.05rem, 2.4vw, 1.25rem);
    max-width: 58ch;
    margin: 1.5rem auto 2.2rem;
    color: #2a2a2a;
  }
  .lead strong {
    font-weight: 800;
  }
  .hero__franja {
    position: absolute;
    inset: auto 0 0 0;
    height: 8px;
    background: linear-gradient(
      90deg,
      var(--negro) 0 33.3%,
      #fff 33.3% 66.6%,
      var(--rojo) 66.6% 100%
    );
  }

  /* ░░ BOTONES ░░ */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--rojo);
    color: #fff;
    text-decoration: none;
    font-weight: 800;
    padding: 0.95rem 1.6rem;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      filter 0.18s ease;
  }
  .btn:hover {
    transform: translateY(-3px);
    filter: brightness(1.07);
    box-shadow: 0 10px 24px rgba(225, 6, 0, 0.28);
  }
  .btn--light {
    background: #fff;
    color: var(--negro);
  }
  .btn--light:hover {
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.25);
  }

  /* ░░ MARQUEE ░░ */
  .marquee {
    background: var(--negro);
    color: var(--crema);
    overflow: hidden;
    padding: 0.85rem 0;
    transform: rotate(-1.4deg) scale(1.04);
    margin: -0.5rem 0;
    border-top: 3px solid var(--rojo);
    border-bottom: 3px solid var(--rojo);
  }
  .marquee__track {
    display: flex;
    width: max-content;
    will-change: transform;
  }
  .marquee__item {
    font-family: var(--cartel);
    text-transform: uppercase;
    font-size: clamp(1.2rem, 3.2vw, 1.9rem);
    letter-spacing: 0.04em;
    padding: 0 1.1rem;
    display: inline-flex;
    align-items: center;
    gap: 1.2rem;
    white-space: nowrap;
  }
  .marquee__sep {
    color: var(--rojo);
    font-weight: 400;
  }

  /* ░░ LAYOUT MAIN ░░ */
  main {
    max-width: 1000px;
    margin: 0 auto;
    padding: clamp(3.5rem, 9vw, 6rem) 1.5rem;
  }
  .seccion-title {
    font-family: var(--marca);
    font-size: clamp(2rem, 6vw, 3.2rem);
    margin-bottom: 1.75rem;
    line-height: 1.1;
  }
  .seccion-title::before {
    content: '';
    display: inline-block;
    width: 28px;
    height: 14px;
    background: var(--rojo);
    margin-right: 0.5rem;
    transform: skewX(-12deg) translateY(-2px);
  }

  /* ░░ QUIÉNES SOMOS ░░ */
  .somos__texto {
    max-width: 70ch;
    font-size: clamp(1.05rem, 2.2vw, 1.2rem);
    color: #2a2a2a;
  }
  .somos__texto p + p {
    margin-top: 1.1rem;
  }
  .somos__texto em {
    font-style: normal;
    background: linear-gradient(transparent 62%, rgba(225, 6, 0, 0.22) 0);
    font-weight: 600;
  }
  .somos__texto strong {
    font-weight: 800;
  }

  /* ░░ STATS ░░ */
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1rem;
    margin: clamp(2.5rem, 6vw, 4rem) 0;
    padding: clamp(1.5rem, 4vw, 2.25rem) 1rem;
    background: var(--negro);
    border-radius: 10px;
    text-align: center;
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .stat__n {
    font-family: var(--cartel);
    font-size: clamp(2.2rem, 7vw, 3.4rem);
    color: var(--rojo);
    line-height: 1;
  }
  .stat__t {
    color: var(--crema);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* ░░ QUÉ HACEMOS ░░ */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.4rem;
  }
  .card {
    position: relative;
    background: #fff;
    border: 2px solid var(--negro);
    border-radius: 6px;
    padding: 2rem 1.7rem 1.7rem;
    box-shadow: 7px 7px 0 var(--negro);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }
  .card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 11px 11px 0 var(--rojo);
  }
  .card__n {
    font-family: var(--cartel);
    color: var(--rojo);
    font-size: 1.1rem;
    letter-spacing: 0.1em;
  }
  .card h3 {
    font-family: var(--marca);
    font-size: 1.4rem;
    margin: 0.35rem 0 0.6rem;
  }
  .card p {
    color: var(--gris);
  }

  /* ░░ MANIFIESTO ░░ */
  .manifiesto {
    text-align: center;
    padding: clamp(3.5rem, 9vw, 6rem) 0 clamp(1rem, 3vw, 2rem);
  }
  .manifiesto__texto {
    font-family: var(--marca);
    font-size: clamp(1.7rem, 5.5vw, 3.2rem);
    line-height: 1.18;
    max-width: 18ch;
    margin: 0 auto;
  }
  .manifiesto__texto :global(.word) {
    display: inline-block;
  }
  .manifiesto__texto :global(.word--rojo) {
    color: var(--rojo);
  }

  /* ░░ BARRIO (banda a todo el ancho) ░░ */
  .barrio-band {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-top: clamp(1rem, 4vw, 2.5rem);
    line-height: 0;
    overflow: hidden;
    border-bottom: 8px solid var(--rojo);
  }

  /* ░░ CTA ░░ */
  .cta {
    margin-top: 0;
    background: #cdb083 url('/carton.svg');
    background-size: cover;
    color: #1f1a12;
    border: 3px solid var(--negro);
    box-shadow: 9px 9px 0 var(--negro);
    border-radius: 8px;
    padding: clamp(2.25rem, 6vw, 3.75rem);
    text-align: center;
  }
  .cta h2 {
    font-family: var(--marca);
    font-size: clamp(2rem, 6vw, 3rem);
    color: var(--negro);
  }
  .cta p {
    color: #3a3120;
    margin: 0.6rem auto 1.9rem;
    max-width: 50ch;
  }

  /* ░░ FOOTER ░░ */
  footer {
    border-top: 2px solid var(--negro);
    padding: 2.5rem 1.5rem;
    text-align: center;
  }
  .footer__name {
    font-family: var(--marca);
    font-size: 1.5rem;
  }
  .muted {
    color: var(--gris);
    font-size: 0.9rem;
    margin-top: 0.25rem;
  }

  /* Estados iniciales para animar (solo con JS y sin reduced-motion) */
  :global(.gsap-ready) [data-hero-item],
  :global(.gsap-ready) [data-hero-lema],
  :global(.gsap-ready) [data-hero-logo],
  :global(.gsap-ready) [data-reveal],
  :global(.gsap-ready) [data-card],
  :global(.gsap-ready) [data-stat],
  :global(.gsap-ready) [data-casa],
  :global(.gsap-ready) .manifiesto__texto :global(.word) {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.gsap-ready) [data-hero-item],
    :global(.gsap-ready) [data-hero-lema],
    :global(.gsap-ready) [data-hero-logo],
    :global(.gsap-ready) [data-reveal],
    :global(.gsap-ready) [data-card],
    :global(.gsap-ready) [data-stat],
    :global(.gsap-ready) [data-casa],
    :global(.gsap-ready) .manifiesto__texto :global(.word) {
      opacity: 1;
    }
  }
</style>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  // Marca el documento como listo para animar: el CSS aplica los estados
  // iniciales (opacity:0) solo cuando esta clase existe, así sin JS la página
  // se ve completa igual.
  document.documentElement.classList.add('gsap-ready')

  // Parte la frase del manifiesto en palabras envueltas en <span>.
  const manifiesto = document.querySelector<HTMLElement>('[data-reveal-words]')
  if (manifiesto) {
    const rojas = new Set(['barrio,', 'barrio', 'barrio.'])
    manifiesto.innerHTML = manifiesto.textContent!
      .trim()
      .split(/\s+/)
      .map((w) => {
        const esRoja = rojas.has(w.toLowerCase())
        return `<span class="word${esRoja ? ' word--rojo' : ''}">${w}</span>`
      })
      .join(' ')
  }

  // Parte el lema del hero en palabras dentro de una máscara, para que cada
  // una "suba" desde abajo. Resalta "comunidad" en rojo.
  const lema = document.querySelector<HTMLElement>('[data-hero-lema]')
  if (lema) {
    lema.innerHTML = lema.textContent!
      .trim()
      .split(/\s+/)
      .map((w) => {
        const rojo = w.toLowerCase().startsWith('comunidad')
        return `<span class="w-wrap"><span class="w${rojo ? ' w--rojo' : ''}">${w}</span></span>`
      })
      .join(' ')
  }

  if (reduce) {
    gsap.set(
      '[data-hero-item], [data-hero-lema], [data-hero-logo], [data-reveal], [data-card], [data-stat], [data-casa], .word, .hero__lema .w',
      { opacity: 1 },
    )
  } else {
    // ── Intro del hero ──
    // El lema es la estrella: cada palabra sube desde una máscara con un
    // rebote, resaltando "comunidad" en rojo. Luego entran el texto, el
    // botón y, discreto, el logo en la esquina.
    gsap.set('[data-hero-lema]', { opacity: 1 })
    const intro = gsap.timeline({ defaults: { ease: 'power3.out' } })
    intro
      .from('.hero__lema .w', {
        yPercent: 120,
        rotation: 7,
        duration: 0.9,
        stagger: 0.075,
        ease: 'back.out(1.7)',
      })
      .fromTo(
        '[data-hero-item]',
        { opacity: 0, y: 26 },
        { opacity: 1, y: 0, duration: 0.7, stagger: 0.13 },
        '-=0.35',
      )
      .fromTo(
        '[data-hero-logo]',
        { opacity: 0, scale: 0.9, y: 14 },
        { opacity: 0.9, scale: 1, y: 0, duration: 0.9, ease: 'power3.out' },
        '-=0.5',
      )

    // ── Marquee infinito ──
    const track = document.querySelector<HTMLElement>('[data-marquee]')
    if (track) {
      gsap.to(track, { xPercent: -50, repeat: -1, duration: 24, ease: 'none' })
    }

    // ── Frase del manifiesto: palabras que suben ──
    gsap.fromTo(
      '.manifiesto__texto .word',
      { opacity: 0, y: 32 },
      {
        opacity: 1,
        y: 0,
        duration: 0.6,
        stagger: 0.07,
        ease: 'power3.out',
        scrollTrigger: { trigger: '.manifiesto', start: 'top 80%' },
      },
    )

    // ── Reveals genéricos ──
    gsap.utils.toArray<HTMLElement>('[data-reveal]').forEach((el) => {
      gsap.fromTo(
        el,
        { opacity: 0, y: 30 },
        {
          opacity: 1,
          y: 0,
          duration: 0.7,
          ease: 'power3.out',
          scrollTrigger: { trigger: el, start: 'top 86%' },
        },
      )
    })

    // ── Stats escalonados ──
    gsap.fromTo(
      '[data-stat]',
      { opacity: 0, y: 24 },
      {
        opacity: 1,
        y: 0,
        duration: 0.55,
        stagger: 0.1,
        ease: 'power3.out',
        scrollTrigger: { trigger: '.stats', start: 'top 85%' },
      },
    )

    // ── Tarjetas escalonadas ──
    gsap.fromTo(
      '[data-card]',
      { opacity: 0, y: 40 },
      {
        opacity: 1,
        y: 0,
        duration: 0.6,
        stagger: 0.13,
        ease: 'power3.out',
        scrollTrigger: { trigger: '.grid', start: 'top 84%' },
      },
    )

    // ── Barrio: las casas se levantan al entrar en pantalla ──
    gsap.fromTo(
      '[data-casa]',
      { opacity: 0, yPercent: 22 },
      {
        opacity: 1,
        yPercent: 0,
        duration: 0.7,
        stagger: 0.05,
        ease: 'power3.out',
        scrollTrigger: { trigger: '.barrio-band', start: 'top 92%' },
      },
    )

    // ── Luces del barrio: ventanas encendidas que titilan ──
    gsap.to('[data-win="on"]', {
      opacity: 0.3,
      duration: 1.3,
      repeat: -1,
      yoyo: true,
      ease: 'sine.inOut',
      stagger: { each: 0.25, from: 'random' },
    })

    // ── Ropa del tendedero ondeando ──
    gsap.to('[data-ropa]', {
      rotation: 8,
      duration: 1.7,
      repeat: -1,
      yoyo: true,
      ease: 'sine.inOut',
      stagger: { each: 0.18 },
    })

    // ── Parallax sutil del skyline ──
    gsap.to('.barrio', {
      yPercent: -10,
      ease: 'none',
      scrollTrigger: {
        trigger: '.barrio-band',
        start: 'top bottom',
        end: 'bottom top',
        scrub: true,
      },
    })
  }
</script>
