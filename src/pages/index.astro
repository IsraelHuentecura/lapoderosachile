---
import Layout from '../layouts/Layout.astro'

// Enlace a redes. Cambia el handle si el de Instagram es distinto.
const INSTAGRAM_URL = 'https://www.instagram.com/lapoderosachile'

// Palabras del marquee (cinta en movimiento).
const palabras = [
  'COMUNIDAD',
  'DERECHOS',
  'BARRIO',
  'DIGNIDAD',
  'PARTICIPACIÓN',
  'PUEBLO',
  'ORGANIZACIÓN',
  'TERRITORIO',
]

// Qué hace la organización. Texto inicial editable.
const ejes = [
  {
    n: '01',
    titulo: 'Organización barrial',
    texto:
      'Construimos comunidad desde los territorios: asambleas, encuentros y trabajo colectivo en cada barrio.',
  },
  {
    n: '02',
    titulo: 'Derechos y dignidad',
    texto:
      'Defendemos los derechos de las vecinas y los vecinos, y luchamos por condiciones de vida dignas para todas y todos.',
  },
  {
    n: '03',
    titulo: 'Cultura y participación',
    texto:
      'Impulsamos espacios culturales, deportivos y educativos abiertos, hechos entre todas y todos.',
  },
]
---

<Layout title="La Poderosa Chile">
  <!-- ░░ HERO ░░ -->
  <header class="hero" data-hero>
    <svg class="estrella" data-parallax viewBox="0 0 100 100" aria-hidden="true">
      <path
        d="M50 2 61.8 38.2 100 38.2 69.1 60.5 80.9 96.8 50 74.5 19.1 96.8 30.9 60.5 0 38.2 38.2 38.2Z"
        fill="#e10600"></path>
    </svg>

    <div class="hero__inner">
      <img
        class="hero__logo"
        data-hero-logo
        src="/logo.png"
        alt="La Poderosa Chile"
        width="1999"
        height="1414"
      />
      <p class="hero__lema" data-hero-item>Organización social y popular</p>
      <p class="lead" data-hero-item>
        Trabajamos en los barrios para construir comunidad, defender derechos y
        abrir espacios de participación.
      </p>
      <a
        class="btn"
        data-hero-item
        href={INSTAGRAM_URL}
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor">
          <path d="M12 2.2c3.2 0 3.6 0 4.9.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.05.41 2.23.06 1.27.07 1.65.07 4.86s0 3.6-.07 4.86c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.05.36-2.23.41-1.27.06-1.65.07-4.9.07s-3.6 0-4.86-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.05-.41-2.23C2.2 15.6 2.2 15.2 2.2 12s0-3.6.07-4.86c.05-1.18.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.05-.36 2.23-.41C8.46 2.2 8.84 2.2 12 2.2Zm0 1.95c-3.15 0-3.52 0-4.76.07-.9.04-1.39.2-1.71.32-.43.17-.74.37-1.06.69-.32.32-.52.63-.69 1.06-.13.32-.28.81-.32 1.71-.06 1.24-.07 1.61-.07 4.76s0 3.52.07 4.76c.04.9.2 1.39.32 1.71.17.43.37.74.69 1.06.32.32.63.52 1.06.69.32.13.81.28 1.71.32 1.24.06 1.61.07 4.76.07s3.52 0 4.76-.07c.9-.04 1.39-.2 1.71-.32.43-.17.74-.37 1.06-.69.32-.32.52-.63.69-1.06.13-.32.28-.81.32-1.71.06-1.24.07-1.61.07-4.76s0-3.52-.07-4.76c-.04-.9-.2-1.39-.32-1.71a2.85 2.85 0 0 0-.69-1.06 2.85 2.85 0 0 0-1.06-.69c-.32-.13-.81-.28-1.71-.32-1.24-.06-1.61-.07-4.76-.07Zm0 3.32a4.53 4.53 0 1 1 0 9.06 4.53 4.53 0 0 1 0-9.06Zm0 1.95a2.58 2.58 0 1 0 0 5.16 2.58 2.58 0 0 0 0-5.16Zm4.74-3.3a1.06 1.06 0 1 1 0 2.12 1.06 1.06 0 0 1 0-2.12Z"></path>
        </svg>
        Síguenos en Instagram
      </a>
    </div>
    <div class="hero__franja" aria-hidden="true"></div>
  </header>

  <!-- ░░ MARQUEE ░░ -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track" data-marquee>
      {
        [...palabras, ...palabras].map((p) => (
          <span class="marquee__item">
            {p}
            <span class="marquee__star">★</span>
          </span>
        ))
      }
    </div>
  </div>

  <main>
    <!-- ░░ MANIFIESTO ░░ -->
    <section class="manifiesto">
      <p class="manifiesto__texto" data-reveal-words>
        Desde el barrio, con el barrio y para el barrio.
      </p>
    </section>

    <!-- ░░ QUÉ HACEMOS ░░ -->
    <section class="que" id="que-hacemos">
      <h2 class="seccion-title" data-reveal><span class="mark">Qué</span> hacemos</h2>
      <div class="grid">
        {
          ejes.map((eje) => (
            <article class="card" data-card>
              <span class="card__n">{eje.n}</span>
              <h3>{eje.titulo}</h3>
              <p>{eje.texto}</p>
            </article>
          ))
        }
      </div>
    </section>

    <!-- ░░ CTA ░░ -->
    <section class="cta" data-reveal>
      <h2>Súmate</h2>
      <p>
        Acércate, participa y conoce en qué estamos. Las novedades y
        convocatorias las publicamos en nuestro Instagram.
      </p>
      <a class="btn btn--light" href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">
        @lapoderosachile
      </a>
    </section>
  </main>

  <footer>
    <p class="footer__name">LA PODEROSA CHILE</p>
    <p class="muted">Hecho entre todas y todos · {new Date().getFullYear()}</p>
  </footer>
</Layout>

<style>
  /* ░░ HERO ░░ */
  .hero {
    position: relative;
    background: #fff;
    padding: clamp(3rem, 8vw, 6rem) 1.5rem clamp(3.5rem, 8vw, 5.5rem);
    text-align: center;
    overflow: hidden;
  }
  .estrella {
    position: absolute;
    top: -4%;
    right: -6%;
    width: clamp(180px, 32vw, 420px);
    opacity: 0.07;
    pointer-events: none;
    will-change: transform;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    max-width: 820px;
    margin: 0 auto;
  }
  .hero__logo {
    width: min(100%, 640px);
    height: auto;
    margin: 0 auto 0.5rem;
    display: block;
    will-change: transform, opacity;
  }
  .hero__lema {
    font-family: var(--cartel);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: clamp(1.1rem, 3.5vw, 1.7rem);
  }
  .hero__lema::after {
    content: '';
    display: block;
    width: 64px;
    height: 5px;
    background: var(--rojo);
    margin: 0.85rem auto 0;
  }
  .lead {
    font-size: clamp(1.05rem, 2.4vw, 1.3rem);
    max-width: 54ch;
    margin: 1.4rem auto 2.1rem;
    color: #2a2a2a;
  }
  .hero__franja {
    position: absolute;
    inset: auto 0 0 0;
    height: 8px;
    background: linear-gradient(
      90deg,
      var(--negro) 0 33.3%,
      #fff 33.3% 66.6%,
      var(--rojo) 66.6% 100%
    );
  }

  /* ░░ BOTONES ░░ */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--rojo);
    color: #fff;
    text-decoration: none;
    font-weight: 800;
    padding: 0.95rem 1.6rem;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease,
      filter 0.18s ease;
  }
  .btn:hover {
    transform: translateY(-3px);
    filter: brightness(1.07);
    box-shadow: 0 10px 24px rgba(225, 6, 0, 0.28);
  }
  .btn--light {
    background: #fff;
    color: var(--negro);
  }
  .btn--light:hover {
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.25);
  }

  /* ░░ MARQUEE ░░ */
  .marquee {
    background: var(--negro);
    color: var(--crema);
    overflow: hidden;
    padding: 0.85rem 0;
    transform: rotate(-1.4deg) scale(1.04);
    margin: -0.5rem 0;
    border-top: 3px solid var(--rojo);
    border-bottom: 3px solid var(--rojo);
  }
  .marquee__track {
    display: flex;
    width: max-content;
    will-change: transform;
  }
  .marquee__item {
    font-family: var(--cartel);
    text-transform: uppercase;
    font-size: clamp(1.3rem, 3.5vw, 2.1rem);
    letter-spacing: 0.04em;
    padding: 0 1.1rem;
    display: inline-flex;
    align-items: center;
    gap: 1.1rem;
    white-space: nowrap;
  }
  .marquee__star {
    color: var(--rojo);
    font-size: 0.8em;
  }

  /* ░░ LAYOUT MAIN ░░ */
  main {
    max-width: 1000px;
    margin: 0 auto;
    padding: clamp(3.5rem, 9vw, 6.5rem) 1.5rem;
  }

  /* ░░ MANIFIESTO ░░ */
  .manifiesto {
    text-align: center;
    padding: 0 0 clamp(3rem, 8vw, 5.5rem);
  }
  .manifiesto__texto {
    font-family: var(--cartel);
    text-transform: uppercase;
    font-size: clamp(2rem, 7vw, 4.2rem);
    line-height: 1.04;
    letter-spacing: 0.005em;
    max-width: 16ch;
    margin: 0 auto;
  }
  .manifiesto__texto :global(.word) {
    display: inline-block;
  }
  .manifiesto__texto :global(.word--rojo) {
    color: var(--rojo);
  }

  /* ░░ QUÉ HACEMOS ░░ */
  .seccion-title {
    font-family: var(--cartel);
    font-size: clamp(2.2rem, 6vw, 3.4rem);
    text-transform: uppercase;
    margin-bottom: 2rem;
  }
  .mark {
    color: var(--rojo);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.4rem;
  }
  .card {
    position: relative;
    background: #fff;
    border: 2px solid var(--negro);
    border-radius: 6px;
    padding: 2rem 1.7rem 1.7rem;
    box-shadow: 7px 7px 0 var(--negro);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }
  .card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 11px 11px 0 var(--rojo);
  }
  .card__n {
    font-family: var(--cartel);
    color: var(--rojo);
    font-size: 1.1rem;
    letter-spacing: 0.1em;
  }
  .card h3 {
    font-family: var(--cartel);
    text-transform: uppercase;
    font-size: 1.35rem;
    letter-spacing: 0.02em;
    margin: 0.35rem 0 0.5rem;
  }
  .card p {
    color: var(--gris);
  }

  /* ░░ CTA ░░ */
  .cta {
    margin-top: clamp(3rem, 7vw, 4.5rem);
    background: var(--negro);
    color: var(--crema);
    border-radius: 10px;
    padding: clamp(2.25rem, 6vw, 3.75rem);
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .cta::before {
    content: '★';
    position: absolute;
    right: -0.2em;
    bottom: -0.35em;
    font-size: 11rem;
    line-height: 1;
    color: var(--rojo);
    opacity: 0.16;
  }
  .cta h2 {
    font-family: var(--cartel);
    text-transform: uppercase;
    font-size: clamp(2rem, 6vw, 3rem);
    color: #fff;
    position: relative;
  }
  .cta p {
    color: #d8d3ca;
    margin: 0.6rem auto 1.9rem;
    max-width: 50ch;
    position: relative;
  }

  /* ░░ FOOTER ░░ */
  footer {
    border-top: 2px solid var(--negro);
    padding: 2.5rem 1.5rem;
    text-align: center;
  }
  .footer__name {
    font-family: var(--cartel);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 1.3rem;
  }
  .muted {
    color: var(--gris);
    font-size: 0.9rem;
    margin-top: 0.25rem;
  }

  /* Estado inicial para animar (solo si hay JS + sin reduced-motion) */
  :global(.gsap-ready) [data-hero-item],
  :global(.gsap-ready) [data-hero-logo],
  :global(.gsap-ready) [data-reveal],
  :global(.gsap-ready) [data-card],
  :global(.gsap-ready) .manifiesto__texto :global(.word) {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.gsap-ready) [data-hero-item],
    :global(.gsap-ready) [data-hero-logo],
    :global(.gsap-ready) [data-reveal],
    :global(.gsap-ready) [data-card],
    :global(.gsap-ready) .manifiesto__texto :global(.word) {
      opacity: 1;
    }
  }
</style>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  // Marca el documento como listo para animar: el CSS aplica los estados
  // iniciales (opacity:0) solo cuando esta clase existe, así sin JS la página
  // se ve completa igual.
  document.documentElement.classList.add('gsap-ready')

  // Parte las frases del manifiesto en palabras envueltas en <span>.
  const manifiesto = document.querySelector<HTMLElement>('[data-reveal-words]')
  if (manifiesto) {
    const rojas = new Set(['barrio.', 'barrio,', 'barrio'])
    manifiesto.innerHTML = manifiesto.textContent!
      .trim()
      .split(/\s+/)
      .map((w) => {
        const esRoja = rojas.has(w.toLowerCase())
        return `<span class="word${esRoja ? ' word--rojo' : ''}">${w}</span>`
      })
      .join(' ')
  }

  if (reduce) {
    // Sin animaciones: aseguramos visibilidad y salimos.
    gsap.set(
      '[data-hero-item], [data-hero-logo], [data-reveal], [data-card], .word',
      { opacity: 1 },
    )
  } else {
    // ── Intro del hero ──
    // Usamos fromTo (no from) con valores de inicio y fin explícitos: el CSS
    // deja estos elementos en opacity:0 para evitar el parpadeo inicial, y
    // `from` los leería como destino 0 (quedarían invisibles).
    const intro = gsap.timeline({ defaults: { ease: 'power3.out' } })
    intro
      .fromTo(
        '[data-hero-logo]',
        { opacity: 0, scale: 0.86, y: 12 },
        { opacity: 1, scale: 1, y: 0, duration: 1.1, ease: 'power4.out' },
      )
      .fromTo(
        '[data-hero-item]',
        { opacity: 0, y: 26 },
        { opacity: 1, y: 0, duration: 0.7, stagger: 0.13 },
        '-=0.5',
      )

    // ── Marquee infinito ──
    const track = document.querySelector<HTMLElement>('[data-marquee]')
    if (track) {
      // El track tiene la lista duplicada: desplazar -50% = un ciclo perfecto.
      gsap.to(track, {
        xPercent: -50,
        repeat: -1,
        duration: 22,
        ease: 'none',
      })
    }

    // ── Estrella decorativa: parallax + giro lento ──
    const estrella = document.querySelector<HTMLElement>('[data-parallax]')
    if (estrella) {
      gsap.to(estrella, {
        yPercent: 38,
        rotation: 45,
        ease: 'none',
        scrollTrigger: {
          trigger: '.hero',
          start: 'top top',
          end: 'bottom top',
          scrub: true,
        },
      })
    }

    // ── Manifiesto: palabras que suben ──
    gsap.to('.manifiesto__texto .word', {
      opacity: 1,
      y: 0,
      duration: 0.6,
      stagger: 0.08,
      ease: 'power3.out',
      scrollTrigger: { trigger: '.manifiesto', start: 'top 78%' },
    })
    gsap.from('.manifiesto__texto .word', {
      y: 32,
      duration: 0.6,
      stagger: 0.08,
      ease: 'power3.out',
      scrollTrigger: { trigger: '.manifiesto', start: 'top 78%' },
    })

    // ── Reveals genéricos al hacer scroll ──
    gsap.utils.toArray<HTMLElement>('[data-reveal]').forEach((el) => {
      gsap.fromTo(
        el,
        { opacity: 0, y: 30 },
        {
          opacity: 1,
          y: 0,
          duration: 0.7,
          ease: 'power3.out',
          scrollTrigger: { trigger: el, start: 'top 85%' },
        },
      )
    })

    // ── Tarjetas: aparecen escalonadas ──
    gsap.fromTo(
      '[data-card]',
      { opacity: 0, y: 40 },
      {
        opacity: 1,
        y: 0,
        duration: 0.6,
        stagger: 0.14,
        ease: 'power3.out',
        scrollTrigger: { trigger: '.grid', start: 'top 82%' },
      },
    )
  }
</script>
